# 값은 .env.local 에만 채우세요. (이 파일에는 이름만)
# Supabase → Project Settings → API (또는 상단 Connect 버튼)
NEXT_PUBLIC_SUPABASE_URL=
# publishable key (sb_publishable_...) — 예전 anon key를 써도 동작
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 앱 안의 AI 튜터용 (서버에서만 사용) — 학교 멀티모달 AI API 키
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# 선택: 모델 바꾸기 (비우면 claude-haiku-5-5)
ANTHROPIC_MODEL=
# 선택: AI 카드 검증 판정 모델 (비우면 claude-haiku-5-5) — 실시간 카드도 이 판정을 통과해야 보여준다
ANTHROPIC_CARD_JUDGE_MODEL=
